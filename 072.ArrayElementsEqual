public class ArrayElementsEqual {
	    public static void main(String[] args) {
	        int[] arr = {5, 5, 5, 5};
	        boolean allEqual = true;

	        for (int i = 1; i < arr.length; i++) {
	            if (arr[i] != arr[0]) {
	                allEqual = false;
	                break;
	            }
	        }

	        if (allEqual)
	            System.out.println("Yes, all numbers are equal");
	        else
	            System.out.println("No, all numbers are not equal");
	    }
	}
