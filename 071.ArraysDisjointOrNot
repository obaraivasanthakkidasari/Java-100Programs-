import java.util.*;
public class ArraysDisJointOrNot {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        // Input first array
        System.out.print("Enter array1: ");
        String[] arr1 = sc.nextLine().split(" ");
        Set<Integer> set1 = new HashSet<>();
        for (String s : arr1) set1.add(Integer.parseInt(s));

        // Input second array
        System.out.print("Enter array2: ");
        String[] arr2 = sc.nextLine().split(" ");
        Set<Integer> set2 = new HashSet<>();
        for (String s : arr2) set2.add(Integer.parseInt(s));

        // Check for intersection
        Set<Integer> intersection = new HashSet<>(set1);
        intersection.retainAll(set2);

        if (!intersection.isEmpty())
            System.out.println("Not a disjoint");
        else
            System.out.println("Disjoint");
    }
}
